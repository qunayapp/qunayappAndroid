<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">

    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="4dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                >

                <LinearLayout
                    android:weightSum="100"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="MissingConstraints">

                    <LinearLayout
                        android:layout_weight="50"
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgHolder"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_pet_house"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginStart="8dp"
                        android:layout_weight="50"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_gravity="end"
                            android:gravity="end"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:src="@drawable/baseline_star_24"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp" />

                            <TextView
                                android:layout_gravity="center"
                                android:textSize="12sp"
                                android:textColor="@color/blue_primary"
                                android:id="@+id/txtValor"
                                android:text="5.0"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <View
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:background="@color/plomoq"
                                android:layout_width="2dp"
                                android:layout_height="match_parent"/>

                            <TextView
                                android:layout_gravity="center"
                                android:textSize="12sp"
                                android:textColor="@color/plomoRegular"
                                android:id="@+id/txtReview"
                                android:text="22 reviews"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <TextView
                            style="@style/WorkSans_Regular11"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/txtTitle"
                            android:gravity="center"
                            android:text="Pet house"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_gravity="center"
                                android:src="@drawable/location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView

                                android:textSize="12sp"
                                android:layout_marginStart="4dp"
                                android:text="La molina"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <TextView
                            android:textColor="@color/plomoq"
                            android:textSize="12sp"
                            android:text="En nuestro hogar, sabemos lo importante que es tu compañero peludo. Nuestro Dog Boarding..."
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_marginBottom="4dp"
                            android:paddingHorizontal="8dp"
                            android:layout_marginTop="4dp"

                            android:background="@drawable/border_linearlayout_precio"
                            android:backgroundTint="@color/blue_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:text="S/ 50.00"
                                android:id="@+id/txtPrecio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                        </LinearLayout>

                        <TextView
                            android:textSize="9sp"
                            android:layout_marginBottom="10dp"
                            android:textColor="@color/plomoq"
                            android:text="* precio referencial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                </LinearLayout>



            </androidx.cardview.widget.CardView>



        </LinearLayout>


    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>